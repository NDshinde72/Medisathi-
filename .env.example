# =====================================================================
# RuralCare AI — Environment Configuration Template
# Academic Project: Final Year B.E. Information Technology Capstone
# =====================================================================

# Server & Application
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"

# Relational Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://ruralcare_user:ruralcare_secure_pass@localhost:5432/ruralcare_db"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="ruralcare_db"
DB_USER="ruralcare_user"
DB_PASSWORD="ruralcare_secure_pass"

# Authentication & Security
JWT_SECRET="super_secret_jwt_key_ruralcare_ai_be_it_project_2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models & LLM Providers
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="your_openai_api_key_here_optional"

# Vector Database & RAG Knowledge Retrieval
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_DB_TYPE="faiss" # Options: faiss, pgvector
VECTOR_DB_PATH="./backend/data/vector_store"
KNOWLEDGE_BASE_DIR="./knowledge_base"
SIMILARITY_TOP_K=4
SIMILARITY_THRESHOLD=0.65

# OCR & Medical Report Extraction
TESSERACT_CMD="/usr/bin/tesseract"
MAX_UPLOAD_FILE_SIZE_MB=15

# Geolocation & Facilities Search
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here_optional"
DEFAULT_SEARCH_RADIUS_KM=25

# Safety & Emergency Triage Hotlines
NATIONAL_AMBULANCE_NUMBER="108"
NATIONAL_EMERGENCY_NUMBER="112"
DISA_HEALTH_HELPLINE="104"

